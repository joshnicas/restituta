# API server port (defaults to 8000)
PORT=8000

# PostgreSQL connection string used by Prisma.
# For the included Docker Compose database, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/resti
DATABASE_URL=

# JWT signing secret (code fallback: development-secret)
JWT_SECRET=

# Seeded admin credentials (code fallbacks: admin@resti.app / admin123)
ADMIN_EMAIL=
ADMIN_PASSWORD=
