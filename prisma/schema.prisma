generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EducationStage {
  PRE_PRIMARY
  PRIMARY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Language {
  EN
  SW
}

enum QuestionMediaType {
  IMAGE
  AUDIO
  VIDEO
}

enum ChallengeType {
  DAILY
  WEEKLY
  SPECIAL
  SPEED
  PERFECT
}

enum PracticeMode {
  QUICK
  SUBJECT
  MISTAKES
}

enum QuestionSource {
  LEVEL
  PRACTICE
  CHALLENGE
}

enum SubscriptionDurationUnit {
  MONTH
}

enum PaymentStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  AMOUNT_MISMATCH
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Admin {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?

  @@map("admins")
}

model CurriculumVersion {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  grades      Grade[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("curriculum_versions")
}

model Grade {
  id                  Int                 @id @default(autoincrement())
  curriculumVersionId Int
  name                String
  code                String
  level               Int
  stage               EducationStage
  active              Boolean             @default(true)
  curriculumVersion   CurriculumVersion   @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  users               User[]
  gradeSubjects       GradeSubject[]
  userLevelProgress   UserLevelProgress[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([curriculumVersionId, code])
  @@unique([curriculumVersionId, level])
  @@map("grades")
}

model Player {
  id          Int          @id @default(autoincrement())
  name        String
  url1        String?
  url2        String?
  description String?
  users       User[]
  skins       PlayerSkin[]

  @@map("players")
}

model PlayerSkin {
  id          Int     @id @default(autoincrement())
  playerId    Int?
  name        String
  url1        String?
  url2        String?
  description String?
  player      Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  users       User[]

  @@map("player_skins")
}

model User {
  id               Int                   @id @default(autoincrement())
  userID           String                @unique
  email            String?               @unique
  emailStatus      Boolean               @default(false)
  language         Language              @default(EN)
  DoB              DateTime?
  gradeId          Int?
  schoolCode       String?
  profilePic       String?
  playerId         Int?
  playerSkinId     Int?
  currentStreak    Int                   @default(0)
  longestStreak    Int                   @default(0)
  lastActivityDate DateTime?
  grade            Grade?                @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  player           Player?               @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerSkin       PlayerSkin?           @relation(fields: [playerSkinId], references: [id], onDelete: SetNull)
  gameProfile      UserGameProfile?
  attempts         UserQuestionAttempt[]
  dailyActivities  DailyActivity[]
  progress         UserLevelProgress[]
  userChallenges   UserChallenge[]
  userGifts        UserGift[]
  rewardLedger     UserRewardLedger[]
  payments         Payment[]
  subscriptions    Subscription[]
  authSessions     AuthSession[]
  practiceSessions PracticeSession[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("users")
}

model SubscriptionPlan {
  id           String                    @id @default(cuid())
  code         String                    @unique
  name         String
  duration     Int
  durationUnit SubscriptionDurationUnit  @default(MONTH)
  price        Int
  currency     String                    @default("TZS")
  isActive     Boolean                   @default(true)
  payments     Payment[]
  subscriptions Subscription[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@map("subscription_plans")
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     Int
  deviceId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Payment {
  id                       String       @id @default(cuid())
  userId                   Int
  planId                   String
  upgradeFromSubscriptionId String?
  provider                 String       @default("SAYARI")
  externalRef              String       @unique
  providerOrderId          String?      @unique
  amount                   Int
  currency                 String       @default("TZS")
  buyerPhone               String
  status                   PaymentStatus @default(CREATED)
  providerReference        String?
  providerTransactionId    String?
  resultCode               String?
  failureReason            String?
  orderIdempotencyKey      String       @unique
  walletIdempotencyKey     String       @unique
  completedAt              DateTime?
  user                     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription             Subscription?
  upgradeFromSubscription Subscription? @relation("SubscriptionUpgradePayment", fields: [upgradeFromSubscriptionId], references: [id], onDelete: SetNull)
  events                   PaymentEvent[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([externalRef])
  @@index([providerOrderId])
  @@index([createdAt])
  @@map("payments")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    Int
  planId    String
  paymentId String             @unique
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime
  expiresAt DateTime
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment   Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  upgradePayments Payment[]     @relation("SubscriptionUpgradePayment")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status, expiresAt])
  @@map("subscriptions")
}

model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  orderId     String?
  paymentId   String?
  safePayload Json?
  processedAt DateTime?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderId])
  @@index([createdAt])
  @@map("payment_events")
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  icon          String?
  description   String?
  active        Boolean        @default(true)
  topics        Topic[]
  gradeSubjects GradeSubject[]
  practiceSessions PracticeSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("subjects")
}

model GradeSubject {
  id        Int                 @id @default(autoincrement())
  gradeId   Int
  subjectId Int
  active    Boolean             @default(true)
  grade     Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    GradeSubjectTopic[]
  levels    GameLevel[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([gradeId, subjectId])
  @@map("grade_subjects")
}

model Topic {
  id                 Int                 @id @default(autoincrement())
  subjectId          Int
  name               String
  code               String
  description        String?
  active             Boolean             @default(true)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeSubjectTopics GradeSubjectTopic[]
  competencies       Competency[]
  questions          Question[]
  practiceSessions  PracticeSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([subjectId, code])
  @@map("topics")
}

model GradeSubjectTopic {
  id             Int          @id @default(autoincrement())
  gradeSubjectId Int
  topicId        Int
  active         Boolean      @default(true)
  gradeSubject   GradeSubject @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([gradeSubjectId, topicId])
  @@map("grade_subject_topics")
}

model GameLevel {
  id             Int                 @id @default(autoincrement())
  gradeSubjectId Int
  levelNumber    Int
  name           String
  description    String?
  difficulty     Difficulty          @default(EASY)
  requiredPoints Int                 @default(0)
  timeLimit      Int?
  active         Boolean             @default(true)
  gradeSubject   GradeSubject        @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  questions      Question[]
  progress       UserLevelProgress[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([gradeSubjectId, levelNumber])
  @@map("game_levels")
}

model GameType {
  id          Int        @id @default(autoincrement())
  name        String
  code        String     @unique
  description String?
  active      Boolean    @default(true)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("game_types")
}

model Question {
  id              Int                      @id @default(autoincrement())
  gameLevelId     Int
  topicId         Int?
  gameTypeId      Int
  text            String
  image           String?
  audio           String?
  explanation     String?
  points          Int                      @default(10)
  timeLimit       Int?
  active          Boolean                  @default(true)
  gameLevel       GameLevel                @relation(fields: [gameLevelId], references: [id], onDelete: Cascade)
  topic           Topic?                   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  gameType        GameType                 @relation(fields: [gameTypeId], references: [id])
  options         QuestionOption[]
  translations    QuestionTranslation[]
  trueFalse       QuestionTrueFalse?
  matches         QuestionMatchPair[]
  orderingItems   QuestionOrderingItem[]
  acceptedAnswers QuestionAcceptedAnswer[]
  media           QuestionMedia[]
  competencies    QuestionCompetency[]
  themes          QuestionTheme[]
  attempts        UserQuestionAttempt[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([gameLevelId])
  @@index([gameTypeId])
  @@map("questions")
}

model QuestionTranslation {
  id          Int      @id @default(autoincrement())
  questionId  Int
  language    Language
  text        String
  explanation String?
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([questionId, language])
  @@index([language])
  @@map("question_translations")
}

model QuestionOption {
  id         Int                        @id @default(autoincrement())
  questionId Int
  text       String?
  image      String?
  audio      String?
  isCorrect  Boolean                    @default(false)
  order      Int                        @default(0)
  question   Question                   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations QuestionOptionTranslation[]

  @@unique([questionId, order])
  @@map("question_options")
}

model QuestionOptionTranslation {
  id              Int             @id @default(autoincrement())
  questionOptionId Int
  language        Language
  text            String?
  questionOption  QuestionOption  @relation(fields: [questionOptionId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([questionOptionId, language])
  @@index([language])
  @@map("question_option_translations")
}

model QuestionTrueFalse {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  answer     Boolean
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_true_false_answers")
}

model QuestionMatchPair {
  id         Int                         @id @default(autoincrement())
  questionId Int
  leftText   String?
  leftImage  String?
  rightText  String?
  rightImage String?
  order      Int                         @default(0)
  question   Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations QuestionMatchPairTranslation[]

  @@unique([questionId, order])
  @@map("question_match_pairs")
}

model QuestionMatchPairTranslation {
  id                 Int             @id @default(autoincrement())
  questionMatchPairId Int
  language           Language
  leftText           String?
  rightText          String?
  questionMatchPair  QuestionMatchPair @relation(fields: [questionMatchPairId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([questionMatchPairId, language])
  @@index([language])
  @@map("question_match_pair_translations")
}

model QuestionOrderingItem {
  id           Int                              @id @default(autoincrement())
  questionId   Int
  text         String?
  image        String?
  correctOrder Int
  question     Question                         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations QuestionOrderingItemTranslation[]

  @@unique([questionId, correctOrder])
  @@map("question_ordering_items")
}

model QuestionOrderingItemTranslation {
  id                    Int                 @id @default(autoincrement())
  questionOrderingItemId Int
  language              Language
  text                  String?
  questionOrderingItem  QuestionOrderingItem @relation(fields: [questionOrderingItemId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([questionOrderingItemId, language])
  @@index([language])
  @@map("question_ordering_item_translations")
}

model QuestionAcceptedAnswer {
  id              Int      @id @default(autoincrement())
  questionId      Int
  language        Language @default(EN)
  answer          String
  isCaseSensitive Boolean  @default(false)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language, answer])
  @@index([language])
  @@map("question_accepted_answers")
}

model QuestionMedia {
  id         Int               @id @default(autoincrement())
  questionId Int
  type       QuestionMediaType
  url        String
  altText    String?
  order      Int               @default(0)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, type, order])
  @@map("question_media")
}

model Competency {
  id          Int                  @id @default(autoincrement())
  topicId     Int
  name        String
  code        String?
  description String?
  active      Boolean              @default(true)
  topic       Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions   QuestionCompetency[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([topicId, code])
  @@map("competencies")
}

model QuestionCompetency {
  questionId   Int
  competencyId Int
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([questionId, competencyId])
  @@map("question_competencies")
}

model ImageCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  images    Image[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("image_categories")
}

model Image {
  id              Int           @id @default(autoincrement())
  imageCategoryId Int
  name            String
  url             String?
  imageCategory   ImageCategory @relation(fields: [imageCategoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([imageCategoryId])
  @@map("images")
}

model AudioCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  audios    Audio[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("audio_categories")
}

model Audio {
  id              Int           @id @default(autoincrement())
  audioCategoryId Int
  name            String
  url             String?
  audioCategory   AudioCategory @relation(fields: [audioCategoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([audioCategoryId])
  @@map("audios")
}

model CrossCuttingTheme {
  id          Int             @id @default(autoincrement())
  name        String
  code        String          @unique
  description String?
  active      Boolean         @default(true)
  questions   QuestionTheme[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("cross_cutting_themes")
}

model QuestionTheme {
  questionId Int
  themeId    Int
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  theme      CrossCuttingTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([questionId, themeId])
  @@map("question_themes")
}

model UserGameProfile {
  userId        Int       @id
  key           String?
  xp            Int       @default(0)
  coins         Int       @default(0)
  stars         Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lives         Int       @default(3)
  nextLifeAt    DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_game_profiles")
}

model UserQuestionAttempt {
  id           Int      @id @default(autoincrement())
  userId       Int
  questionId   Int
  source       QuestionSource @default(LEVEL)
  practiceSessionId String?
  isCorrect    Boolean
  pointsEarned Int      @default(0)
  coinsEarned  Int      @default(0)
  timeTaken    Int?
  answerData   Json?
  attemptedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, attemptedAt])
  @@index([userId, source])
  @@index([userId, questionId])
  @@index([questionId])
  @@index([practiceSessionId])
  @@unique([practiceSessionId, questionId])
  @@map("user_question_attempts")
}

model PracticeSession {
  id                String        @id @default(cuid())
  userId            Int
  mode              PracticeMode
  subjectId         Int?
  topicId           Int?
  questionIds       Json
  totalQuestions    Int
  answeredQuestions Int           @default(0)
  correctAnswers    Int           @default(0)
  pointsEarned      Int           @default(0)
  starsEarned       Int           @default(0)
  completed         Boolean       @default(false)
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic             Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts          UserQuestionAttempt[]

  @@index([userId, startedAt])
  @@index([userId, mode])
  @@index([subjectId])
  @@index([topicId])
  @@map("practice_sessions")
}

model DailyActivity {
  id                String   @id @default(uuid())
  userId            Int
  activityDate      DateTime
  questionsAnswered Int      @default(0)
  pointsEarned      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId, activityDate])
  @@map("daily_activities")
}

model UserLevelProgress {
  id           Int       @id @default(autoincrement())
  userId       Int
  gradeId      Int?
  gameLevelId  Int
  completed    Boolean   @default(false)
  px           Int       @default(0)
  stars        Int       @default(0)
  bestScore    Int       @default(0)
  attempts     Int       @default(0)
  passAttempts Int       @default(0)
  pendingXp    Int       @default(0)
  pendingStars Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade        Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  gameLevel    GameLevel @relation(fields: [gameLevelId], references: [id], onDelete: Cascade)

  @@unique([userId, gameLevelId])
  @@map("user_level_progress")
}

model Challenge {
  id              String               @id @default(uuid())
  title           String
  description     String?
  type            ChallengeType
  gradeId         String?
  subjectId       String?
  topicId         String?
  targetQuestions Int                  @default(10)
  timeLimit       Int?
  pointsReward    Int                  @default(0)
  starsReward     Int                  @default(0)
  startsAt        DateTime
  endsAt          DateTime?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  translations    ChallengeTranslation[]
  userChallenges  UserChallenge[]

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@index([gradeId])
  @@index([subjectId])
  @@index([topicId])
  @@map("challenges")
}

model ChallengeTranslation {
  id          String    @id @default(uuid())
  challengeId String
  language    Language
  title       String
  description String?
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, language])
  @@index([language])
  @@map("challenge_translations")
}

model UserChallenge {
  id                     String    @id @default(uuid())
  userId                 String
  challengeId            String
  selectedGradeSubjectId String?
  periodKey              String    @default("LIFETIME")
  questionsAnswered      Int       @default(0)
  correctAnswers         Int       @default(0)
  completed              Boolean   @default(false)
  claimed                Boolean   @default(false)
  failed                 Boolean   @default(false)
  completedAt            DateTime?
  pointsEarned           Int       @default(0)
  starsEarned            Int       @default(0)
  startedAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [userID], onDelete: Cascade)
  challenge              Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, periodKey])
  @@index([userId])
  @@index([challengeId])
  @@map("user_challenges")
}

model Gift {
  id            String            @id @default(uuid())
  name          String
  description   String
  imageUrl      String
  type          String
  pointsAwarded Int               @default(0)
  starsAwarded  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  GiftTranslation[]
  userGifts     UserGift[]

  @@index([type])
  @@map("gifts")
}

model GiftTranslation {
  id          String   @id @default(uuid())
  giftId      String
  language    Language
  name        String
  description String
  gift        Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@unique([giftId, language])
  @@index([language])
  @@map("gift_translations")
}

model UserGift {
  id        String   @id @default(uuid())
  userId    Int
  giftId    String
  awardedAt DateTime @default(now())
  isViewed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@index([userId, awardedAt])
  @@index([giftId])
  @@map("user_gifts")
}

model UserRewardLedger {
  id         Int      @id @default(autoincrement())
  userId     Int
  sourceType String
  sourceId   String
  xpDelta    Int      @default(0)
  starsDelta Int      @default(0)
  gradeId    Int?
  subjectId  Int?
  earnedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId, earnedAt])
  @@index([earnedAt])
  @@index([gradeId, subjectId, earnedAt])
  @@map("user_reward_ledger")
}
