# =========================================================
# Dependencies
# =========================================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/

# =========================================================
# Build output
# =========================================================
dist/
build/
out/
*.tsbuildinfo
*.js.map

# =========================================================
# Environment files — NEVER commit
# =========================================================
.env
.env.*
!.env.example

# =========================================================
# Logs
# =========================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
lerna-debug.log*

# =========================================================
# GCP service account keys — NEVER commit
# =========================================================
kido-*.json
*-service-account*.json
*-credentials*.json
gcp-*.json
!package.json
!package-lock.json
!tsconfig.json

# =========================================================
# Local storage / uploads
# Files served from storage/ at runtime should not be
# tracked; only the directory skeleton (.gitkeep) stays.
# =========================================================
storage/app/public/skins/*
!storage/app/public/skins/.gitkeep
storage/app/public/players/*
!storage/app/public/players/.gitkeep
storage/app/public/images/*
!storage/app/public/images/.gitkeep
storage/app/public/audios/*
!storage/app/public/audios/.gitkeep
storage/app/public/songs/*
!storage/app/public/songs/.gitkeep

# =========================================================
# Test & coverage
# =========================================================
coverage/
.nyc_output/
*.lcov
junit.xml

# =========================================================
# Runtime / cache
# =========================================================
.cache/
.temp/
.tmp/
*.pid
*.seed
*.pid.lock

# =========================================================
# Editor & IDE
# =========================================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# =========================================================
# OS junk
# =========================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =========================================================
# Local dev tooling
# =========================================================
.kilo/
.npm/
.eslintcache
.stylelintcache

# =========================================================
# Prisma local artifacts
# =========================================================
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# =========================================================
# Docker overrides (local dev only)
# =========================================================
docker-compose.override.yml
